{
  "name": "@ts-template/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_TARGET=node vite",
    "dev:cf": "vite",
    "build": "pnpm typecheck && VITE_TARGET=node vite build",
    "build:cf": "pnpm typecheck && vite build",
    "serve": "node --env-file-if-exists=.dev.vars --import tsx src/node.ts",
    "migrate:node": "node --env-file-if-exists=.dev.vars --import tsx scripts/migrate.ts",
    "preview": "vite preview",
    "types:cf": "wrangler types",
    "typecheck": "pnpm types:cf && tsc --noEmit",
    "deploy:cf": "pnpm build:cf && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ts-template --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply ts-template --remote"
  },
  "dependencies": {
    "@hono/inertia": "^0.7.1",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@inertiajs/core": "^3.7.0",
    "@inertiajs/react": "^3.7.0",
    "@libsql/client": "^0.17.4",
    "@ts-template/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
