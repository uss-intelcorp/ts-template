{
  "name": "@ts-template/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_TARGET=node vite",
    "dev:cf": "vite",
    "build": "tsc --noEmit && VITE_TARGET=node vite build",
    "build:cf": "tsc --noEmit && vite build",
    "serve": "node --env-file-if-exists=.dev.vars --import tsx src/node.ts",
    "migrate:node": "node --env-file-if-exists=.dev.vars --import tsx scripts/migrate.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:cf": "tsc --noEmit && vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ts-template --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply ts-template --remote"
  },
  "dependencies": {
    "@hono/inertia": "^0.5.0",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-validator": "^0.8.0",
    "@inertiajs/react": "^3.4.0",
    "@libsql/client": "^0.17.3",
    "@ts-template/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@cloudflare/workers-types": "^4.20260612.1",
    "@hono/vite-dev-server": "^0.26.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.100.0"
  }
}
