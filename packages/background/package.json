{
  "name": "@ts-template/background",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm worker",
    "scheduler": "node --env-file-if-exists=../web/.dev.vars --import tsx src/scheduler.ts",
    "worker": "node --env-file-if-exists=../web/.dev.vars --import tsx src/worker.ts",
    "once": "node --env-file-if-exists=../web/.dev.vars --import tsx src/once.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@ts-template/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
