{
  "name": "@ts-template/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_TARGET=node vite",
    "dev:cf": "vite",
    "build": "tsc --noEmit && VITE_TARGET=node vite build",
    "build:cf": "tsc --noEmit && vite build",
    "serve": "node --env-file-if-exists=.dev.vars --import tsx src/node.ts",
    "migrate:node": "node --env-file-if-exists=.dev.vars --import tsx scripts/migrate.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:cf": "tsc --noEmit && vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ts-template --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply ts-template --remote"
  },
  "dependencies": {
    "@hono/inertia": "^0.7.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@inertiajs/react": "^3.6.1",
    "@libsql/client": "^0.17.4",
    "@ts-template/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}
